generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  WAITLIST
}

model User {
  id              String                @id @default(cuid())
  name            String
  email           String                @unique
  phone           String?
  avatar          String?
  passwordHash    String
  role            Role                  @default(USER)
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  registrations   ProgramRegistration[]
  resetTokens     PasswordResetToken[]
  createdPrograms Program[]             @relation("ProgramCreatedBy")
  updatedPrograms Program[]             @relation("ProgramUpdatedBy")

  feedbacks Feedback[]
  favorites Favorite[]
}

model ProgramCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  programs Program[]
}

model TargetAudience {
  id       String    @id @default(cuid())
  name     String    @unique
  programs Program[]
}

model Program {
  id                   String                @id @default(cuid())
  title                String
  slug                 String                @unique
  shortDescription     String
  description          String
  coverImage           String
  cardImage            String
  location             String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  capacity             Int
  price                Float                 @default(0)
  status               ProgramStatus         @default(DRAFT)
  featured             Boolean               @default(false)
  showInSlider         Boolean               @default(false)
  isNew                Boolean               @default(false)
  backgroundColor      String                @default("#075658")
  sliderOrder          Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  categoryId           String?
  category             ProgramCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bannerImage          String?
  targetAudienceId     String?
  targetAudience       TargetAudience?       @relation(fields: [targetAudienceId], references: [id], onDelete: SetNull)
  goals                String?
  features             String?
  requirements         String?
  faq                  String?
  createdById          String?
  createdBy            User?                 @relation("ProgramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?                 @relation("ProgramUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  registrations        ProgramRegistration[]
  feedbacks            Feedback[]
  favorites            Favorite[]
}

model ProgramRegistration {
  id        String             @id @default(cuid())
  userId    String
  programId String
  status    RegistrationStatus @default(CONFIRMED)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program            @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@unique([userId, programId])
  @@index([programId, status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  programId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([programId])
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  logo         String
  url          String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  quote        String
  name         String
  title        String?
  rating       Int      @default(5)
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StaffGroup {
  id           String        @id @default(cuid())
  name         String?
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      StaffMember[]
  parentId     String?
  parent       StaffGroup?   @relation("StaffGroupRows", fields: [parentId], references: [id], onDelete: SetNull)
  rows         StaffGroup[]   @relation("StaffGroupRows")

  @@index([parentId, displayOrder])
}

model StaffMember {
  id           String     @id @default(cuid())
  name         String
  jobTitle     String
  icon         String     @default("")
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  groupId      String
  group        StaffGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, displayOrder])
}

// ملاحظة: هذا الموديل ما عاد يُستخدم من الكود (قسم "الإحصائيات" بالرئيسية
// صار محسوبًا بالكامل تلقائيًا من البيانات الحقيقية - راجع src/lib/homepage-stats.ts).
// أبقيناه هنا بدون حذف الجدول أو بياناته القديمة من قاعدة البيانات.
model Statistic {
  id           String   @id @default(cuid())
  title        String
  value        Int
  prefix       String?
  suffix       String?
  icon         String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AboutContent {
  id           String   @id @default("main")
  introduction String
  vision       String
  mission      String
  goals        String
  values       String
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum FeedbackType {
  GENERAL // رأي عام عن طاقات
  PROGRAM // رأي عن برنامج محدد
  SUGGESTION // اقتراح أو فكرة جديدة
  ISSUE // ملاحظة أو مشكلة
  OTHER // أخرى
}

enum FeedbackStatus {
  PENDING // قيد المراجعة
  APPROVED // معتمد (قد يُنشر أو لا)
  HIDDEN // مخفي (لن يظهر للعامة)
}

model Feedback {
  id        String         @id @default(cuid())
  type      FeedbackType
  message   String
  email     String
  name      String?
  consent   Boolean        @default(false) // موافقة المستفيدة على العرض العام
  status    FeedbackStatus @default(PENDING)
  adminNote String? // ملاحظة داخلية للإدارة، غير معروضة للعامة

  // يصير true بعد ما تنشرها الإدارة كشهادة في "قالوا عنا" — يمنع النشر المكرر
  publishedAsTestimonial Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([email, createdAt]) // يستخدم لمنع تكرار الإرسال السريع (anti-spam)
}
